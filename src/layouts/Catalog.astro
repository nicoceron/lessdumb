---
import Layout from './Layout.astro';
const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <main>
    <nav aria-label="Catalog navigation">
      <a href="/">lessdumb</a> · <a href="/catalog/">Course catalog</a>
    </nav>
    <slot />
  </main>
</Layout>
<style>
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    line-height: 1.7;
  }
  nav {
    margin-bottom: 2rem;
  }
  main :global(a) {
    color: var(--primary, #326bbc);
    text-decoration: underline;
  }
  main :global(h1) {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    margin: 1.5rem 0;
  }
  main :global(h2) {
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 2rem 0 0.75rem;
  }
  main :global(p) {
    margin: 0.75rem 0;
  }
  main :global(li) {
    margin: 0.5rem 0;
  }
</style>
