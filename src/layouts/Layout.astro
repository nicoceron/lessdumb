---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title = 'lessdumb — A little better, every day.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Learn Python through a connected knowledge graph, deliberate practice, and automatic Anki cards. A little better, every day."
    />
    <meta name="theme-color" content="#203e36" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
