{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "tmp",
    "public/pyodide",
    "playwright-report",
    "test-results",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "#request-backend": ["./src/lib/server/request-backend.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true
  }
}
