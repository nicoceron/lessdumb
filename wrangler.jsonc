{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lessdumb",
  "account_id": "290e6974d5ab11e9b3563b1c6f9b4584",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lessdumb",
      "database_id": "6bf2d841-925d-4d55-9507-38d56a643717",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "BETTER_AUTH_URL": "https://lessdumb.nicocerond.workers.dev" },
}
